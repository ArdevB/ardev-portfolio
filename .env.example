# ─────────────────────────────────────────────────────────────
# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────

# GitHub username whose public repos/activity the site shows.
GITHUB_USERNAME=ArdevB

# Fine-grained personal access token (server-only, never sent to the browser).
# Repository access: "All repositories" · Permissions: Metadata → Read-only.
# Without it the site falls back to the unauthenticated API (no contribution
# graph, 60 requests/hour) and the admin "Sync" button is disabled.
GITHUB_TOKEN=

# Auth.js — generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app for the admin login (use a separate app for localhost).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Only this GitHub numeric user ID may sign in to /admin.
# Find yours: https://api.github.com/users/<username>  →  "id"
ADMIN_GITHUB_ID=

# Production only: the canonical site URL Auth.js uses for callbacks.
# AUTH_URL=https://ardevbajracharya.com.np

# Postgres (Neon or Supabase) — use the *pooled* connection string.
DATABASE_URL=

# Optional: enables cover-image uploads in the admin (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# Optional, dev only: path to a saved GitHub snapshot JSON for offline work.
# GITHUB_FIXTURE=./fixtures/github.json

# Secret for the hidden admin sign-in page: open /admin/login?k=<this value>
ADMIN_LOGIN_KEY=
